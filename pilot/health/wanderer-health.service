[Unit]
Description=Wanderer Pilot health monitor
Documentation=file:/usr/local/share/doc/wanderer-health/README.md
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/libexec/wanderer-health/wanderer-health.sh
EnvironmentFile=-/etc/default/wanderer-health
RuntimeDirectory=wanderer
RuntimeDirectoryMode=0755
Restart=always
RestartSec=2

# GPIO LED sysfs entries are root-owned.
User=root
Group=root

NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelModules=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
